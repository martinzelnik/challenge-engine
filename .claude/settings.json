{
  "permissions": {
    "allow": [
      "Bash(git push -u origin feat/:*)",
      "Bash(git push origin feat/:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./evals/tasks/*/hidden_tests/**)",
      "Edit(./evals/**)",
      "Edit(./docs/spec.md)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin --delete:*)"
    ]
  }
}
